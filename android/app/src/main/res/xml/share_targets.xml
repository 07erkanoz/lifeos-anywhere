<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Direct Share: the dynamic shortcuts DirectShareService publishes (one per
         device, category SHARE_TARGET) show in the system share sheet. -->
    <share-target android:targetClass="com.lifeos.anyware.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.lifeos.anyware.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
